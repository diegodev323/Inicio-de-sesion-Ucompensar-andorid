<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- BARRA SUPERIOR: ícono de cerrar sesión en la esquina derecha -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- SALUDO PERSONALIZADO (según la hora y el usuario autenticado) -->
        <TextView
            android:id="@+id/tvSaludo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="30dp"
            android:gravity="center_horizontal"
            android:text=""
            android:textColor="#4A424D"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnParImpar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ejercicio Par o Impar" />

    </LinearLayout>
</LinearLayout>
